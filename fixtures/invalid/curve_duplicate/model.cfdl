version 0.1
model "curve-duplicate"
time calendar monthly from 2026-01 for 12

curve sofr {
  2026-01: 0.045
}

curve sofr {
  2026-01: 0.042
}

entity fund buyer

stream test.interest on entity fund.buyer inflow currency USD {
  schedule every monthly from 2026-01 to 2026-12
  amount = curve_value("sofr", time.date)
}
