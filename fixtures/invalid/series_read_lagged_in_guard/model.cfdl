version 0.1
model "series-read-lagged-in-guard"
use pack "cre" version "0.1.0"
time calendar monthly from 2026-01 for 12

// THE LAGGED SPELLING IS REFUSED TOO, AND IT IS THE ONE THAT WILL BECOME
// LEGAL.
//
// This guard reads only SETTLED history — last period's realised rent — which
// is cycle-free by the same argument as `prev`, and is the spelling `docs/28`
// §4 makes legal under the period walk. It is refused today because the
// engine is stage-wise: the state stage completes over the WHOLE timeline
// before the streams stage begins, so at guard time no stream has a value for
// any period and even the past has not been computed yet.
//
// Measured before this was refused: it never fired. The engine warned per
// period, in the results document, and reported `status: ok` — so a model
// written in the idiom the language is moving toward ran, produced a full set
// of numbers, and did nothing it was asked to do.
//
// When the walk lands this fixture moves to `valid/` and the event fires in
// August.

entity asset suite : CRE.Asset.Unit {
  rentable_area = 1000
  state leased
}

stream cre.rent on entity asset.suite inflow currency USD {
  schedule every month from 2026-01 to 2026-06
  category operating.revenue.base_rent
  amount = 100
  active in state leased
}

event delinquent when series_sum("cre.rent", max(time.t - 1, 0), max(time.t - 1, 0)) < 50 {
  set entity asset.suite.status = "downtime"
}
