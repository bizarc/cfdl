version 0.1
model "cre-lease-up-bad-occupancy"
use pack "cre" version "0.1.0"
time calendar monthly from 2026-01 for 36

entity real_estate property

contract cre.lease {
  term 2026-07..2028-12
  terms {
    base_rent = 25000
    lease_up.months = 18
    lease_up.start_occupancy = 1.2
    lease_up.end_occupancy = 1.0
  }
}
