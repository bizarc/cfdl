version 0.1
model "arrival-action-unfilled-role"
use pack "cre" version "0.1.0"
time calendar monthly from 2026-01 for 24

entity asset tower : CRE.Asset.RealProperty {
  state stabilized
}

// A NAME NOTHING ON THIS ENTITY CARRIES. `balance` is the account
// Contract.Debt declares, and a machine may set it by that name — but this
// tower carries no debt: no contract opened a balance on it and no field
// plays the role, so the machine cannot extinguish what the entity does not
// carry. A MODEL's action names the entity it means, and saying so is the
// point; a pack's would be a no-op here.
lifecycle cre.property {
  on enter disposed {
    set balance = 0
  }
}
