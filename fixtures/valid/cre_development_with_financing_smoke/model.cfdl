version 0.1
model "cre-development-with-financing"
use pack "cre" version "0.1.0"
time calendar monthly from 2026-01 for 72

entity real_estate property
entity loan construction
entity loan permanent

contract cre.construction_stub on entity real_estate.property {
  term 2026-01..2026-06
  terms {
    amount = 45000
  }
}

contract cre.lease on entity real_estate.property {
  term 2026-07..2031-12
  terms {
    base_rent = 25000
  }
}

contract cre.ops_revenue on entity real_estate.property {
  term 2028-01..2031-12
  terms {
    amount = 30000
  }
}

contract cre.ops_expense on entity real_estate.property {
  term 2028-01..2031-12
  terms {
    amount = 12000
  }
}

contract cre.exit_cap on entity real_estate.property {
  term 2031-12..2031-12
  terms {
    exit_cap = 0.06
    noi_value = 180000
  }
}

stream loan.construction_interest on entity loan.construction {
  schedule every month from 2026-01 to 2027-06
  amount = 40000
}

stream loan.permanent_debt_service on entity loan.permanent {
  schedule every month from 2027-07 to 2031-12
  amount = 55000
}
