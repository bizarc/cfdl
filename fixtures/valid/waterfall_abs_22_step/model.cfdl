version 0.1
model "waterfall-abs-22-step"
use pack "credit" version "0.1.0"
time calendar monthly from 2017-02 for 6

// A REAL 22-STEP PRIORITY OF PAYMENTS, encoded in full.
//
// The structure is a consumer auto ABS: a servicer and a trustee paid ahead of
// the notes, five rated classes paid interest then principal in strict
// seniority, a reserve account topped to a specified level, an
// overcollateralisation target that excess spread turbos toward, and a
// certificateholder taking whatever survives.
//
// This fixture is about EXPRESSIVENESS, not about numbers: the source
// specifies the waterfall and publishes no tranche schedule, so what it can
// prove is that the language says all twenty-two steps without an escape
// hatch. Numeric agreement is a separate case against a runnable reference.
//
// The twenty-two steps use seven rules, and every one is an ordinary
// expression:
//
//   a stated amount              = <expr>
//   capped, with a later overflow  = min(<expr>, <cap>)  /  owed.x - paid.x
//   pay down to a target         = <balance> - <target>
//   remaining balance on a date  = if(time.t >= <n>, <balance>, 0)
//   top an account to a level    = <level> - <balance>
//   everything that survives     = remaining

entity asset trust   : Credit.Asset.LoanPool { collateral_type = "auto"  original_balance = 1000000 }
entity asset class_a : Credit.Asset.Tranche  { seniority = 1  original_balance = 700000 }
entity asset class_b : Credit.Asset.Tranche  { seniority = 2  original_balance = 120000 }
entity asset class_c : Credit.Asset.Tranche  { seniority = 3  original_balance =  90000 }
entity asset class_d : Credit.Asset.Tranche  { seniority = 4  original_balance =  60000 }
entity asset class_e : Credit.Asset.Tranche  { seniority = 5  original_balance =  30000 }
entity asset reserve : Credit.Asset.Tranche  { seniority = 9  original_balance =  20000 }

entity party servicer    : Credit.Party.Servicer { name = "Servicer" }
entity party trustee     : Credit.Party.Issuer   { name = "Trustee" }
entity party sponsor     : Credit.Party.Issuer   { name = "Sponsor" }
entity party certificate : Credit.Party.Investor { name = "Certificateholder" }

// Available funds, the pool balance it is measured against, and the reserve's
// specified level. Declared here because the collateral engine is a separate
// concern from the waterfall this fixture exists to exercise.
state available_funds  { init 95000.0  next prev * 0.97 }
state pool_balance     { init 960000.0 next prev * 0.96 }
state reserve_balance  { init 18000.0  next prev }

assume servicing_fee   = 1875.0        // 2.25% / 12 on the pool
assume trustee_fee     = 900.0
assume trustee_cap     = 750.0         // the stated annual limit, per period
assume specified_reserve = 20000.0
assume oc_target       = 940000.0

waterfall abs.distribution on entity asset.trust {
  schedule every month from 2017-02 to 2017-07
  from state.available_funds

  //  1. the servicer, and amounts the sponsor is entitled to retain
  pay servicing_fee     to party.servicer  = inputs.servicing_fee
  pay sponsor_amounts   to party.sponsor   = 0.0

  //  2. trustee and related parties, subject to a stated cap. Step 21 pays
  //     whatever the cap held back, which is `owed - paid` and nothing else.
  pay trustee_fees      to party.trustee   = min(inputs.trustee_fee, inputs.trustee_cap)

  //  3-5. Class A: interest, then principal down to the pool balance, then
  //       the remaining balance at its final scheduled distribution date.
  pay class_a_interest  to asset.class_a   = 1458.0
  pay class_a_target    to asset.class_a   = entity.asset.class_a.original_balance
                                             - state.pool_balance
  pay class_a_final     to asset.class_a   = if(time.t >= 5,
                                                entity.asset.class_a.original_balance, 0.0)

  //  6-8. Class B, measured on the COMBINED A+B balance after the payments
  //       clauses 4 and 5 made — `paid.` is what "after giving effect to"
  //       means, and it needs no mutable state.
  pay class_b_interest  to asset.class_b   = 300.0
  pay class_b_target    to asset.class_b   = entity.asset.class_a.original_balance
                                             + entity.asset.class_b.original_balance
                                             - paid.class_a_target - paid.class_a_final
                                             - state.pool_balance
  pay class_b_final     to asset.class_b   = if(time.t >= 5,
                                                entity.asset.class_b.original_balance, 0.0)

  //  9-11. Class C
  pay class_c_interest  to asset.class_c   = 262.0
  pay class_c_target    to asset.class_c   = entity.asset.class_a.original_balance
                                             + entity.asset.class_b.original_balance
                                             + entity.asset.class_c.original_balance
                                             - paid.class_a_target - paid.class_a_final
                                             - paid.class_b_target - paid.class_b_final
                                             - state.pool_balance
  pay class_c_final     to asset.class_c   = if(time.t >= 5,
                                                entity.asset.class_c.original_balance, 0.0)

  // 12-14. Class D
  pay class_d_interest  to asset.class_d   = 210.0
  pay class_d_target    to asset.class_d   = entity.asset.class_a.original_balance
                                             + entity.asset.class_b.original_balance
                                             + entity.asset.class_c.original_balance
                                             + entity.asset.class_d.original_balance
                                             - paid.class_a_target - paid.class_a_final
                                             - paid.class_b_target - paid.class_b_final
                                             - paid.class_c_target - paid.class_c_final
                                             - state.pool_balance
  pay class_d_final     to asset.class_d   = if(time.t >= 5,
                                                entity.asset.class_d.original_balance, 0.0)

  // 15-17. Class E — interest "if any", so the same form with a zero coupon
  //        would read identically.
  pay class_e_interest  to asset.class_e   = 120.0
  pay class_e_target    to asset.class_e   = entity.asset.class_a.original_balance
                                             + entity.asset.class_b.original_balance
                                             + entity.asset.class_c.original_balance
                                             + entity.asset.class_d.original_balance
                                             + entity.asset.class_e.original_balance
                                             - paid.class_a_target - paid.class_a_final
                                             - paid.class_b_target - paid.class_b_final
                                             - paid.class_c_target - paid.class_c_final
                                             - paid.class_d_target - paid.class_d_final
                                             - state.pool_balance
  pay class_e_final     to asset.class_e   = if(time.t >= 5,
                                                entity.asset.class_e.original_balance, 0.0)

  // 18. the Noteholders' Principal Distributable Amount
  pay principal_distributable to asset.class_a = 2500.0

  // 19. the reserve account, up to its specified amount
  pay reserve_topup     to asset.reserve   = inputs.specified_reserve - state.reserve_balance

  // 20. principal to achieve the specified overcollateralisation
  pay oc_build          to asset.class_a   = state.pool_balance - inputs.oc_target

  // 21. trustee amounts in excess of the cap that held them back at step 2
  pay trustee_excess    to party.trustee   = owed.trustee_fees - paid.trustee_fees

  // 22. everything that survives
  pay residual          to party.certificate = remaining
}
