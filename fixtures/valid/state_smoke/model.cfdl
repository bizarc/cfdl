version 0.1
model "state-smoke"
time calendar annual from 2026-01 for 5

entity asset co : Asset.Financial

// A rate that decays, which is exactly what pow(1 + g, t) cannot compound:
// it would apply one period's rate as though it had held from the start.
curve growth linear {
  2026-01: 0.05
  2030-01: 0.03
}

// Multiplicative: a compounding index off a varying rate.
state revenue_index {
  init 1.0
  next prev * (1 + curve_value("growth", time.date))
}

// Additive: a plain accumulator.
state cum_capex {
  init 0
  next prev + 100
}

// Reading another state's PREVIOUS value. Mutual reference would be equally
// well-founded — every read is from the completed t-1 column — so declaration
// order carries no meaning.
state lagged_index {
  init 0
  next prev.revenue_index
}

stream co.revenue on entity asset.co inflow currency USD {
  schedule every year from 2026-01 to 2030-01
  amount = 1000 * state.revenue_index
}
