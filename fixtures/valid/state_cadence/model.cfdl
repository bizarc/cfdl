version 0.1
model "state-cadence"
time calendar monthly from 2026-01 for 24

entity asset co : Asset.Financial

// A STATE'S CLOCK IS ITS OWN, exactly as a stream's is.
//
// Without this, a recurrence stepped once per MODEL period, so a pool carried
// on a daily book but paying monthly would compound its hazard 365 times a
// year instead of 12 — not a rounding error, a total loss of the number.
//
// `next prev * 2` makes the step count readable off the value: the state is
// 2^(steps taken), so a wrong cadence is unmissable rather than subtle.
state quarterly_idx {
  schedule every quarter from 2026-01 to 2027-12
  init 1.0
  next prev * 2
}

// No schedule: every model period over the whole timeline, which is what every
// state written before states had a clock assumes. 23 steps over 24 periods.
state monthly_idx {
  init 1.0
  next prev * 2
}

// TWO OFF-BY-ONES THIS FIXTURE EXISTS TO CATCH, both found by building it.
//
// A quarterly schedule ACCRUES at periods 0, 3, 6 and SETTLES at 2, 5, 8 — an
// ordinary annuity earns across its interval and pays at the end. A stream's
// amount is evaluated at the accrual, which is also where the payment index is
// counted, so the recurrence must step on accruals. Ticking on settlements
// instead puts the state a whole quarter away from the index that reads it.
//
// And `init` is the value AT the first tick, not at model period 0: stepping on
// the first accrual would put F(1) where the first payment reads F(0).
//
// So the payments below must be 1, 2, 4, 8 ... — F(0), F(1), F(2) at payment
// indices 0, 1, 2.
stream co.quarterly on entity asset.co inflow currency USD {
  schedule every quarter from 2026-01 to 2027-12
  amount = state.quarterly_idx
}

stream co.monthly on entity asset.co inflow currency USD {
  schedule every month from 2026-01 to 2027-12
  amount = state.monthly_idx
}
