version 0.1
model "tutorial-with-pack"
use pack "opco" version "0.1.0"
time calendar monthly from 2026-01 for 60

entity operating business

contract opco_revenue_line {
  term 2026-01..2030-12
  terms {
    amount = 120000
    growth_rate = 0.0
  }
}

contract opco_opex_line {
  term 2026-01..2030-12
  terms {
    amount = 70000
  }
}
