version 0.1
model "exercise-priority-of-payments"
time calendar quarterly from 2026-01 for 8

// Quarterly collections arrive in the trust; the parties are paid from them.
entity asset trust : Asset.Financial

entity party servicer : Party
entity party lender : Party
entity party investor : Party

// The trust's cash. The waterfall's pot is this, netted — the engine hands it
// over as `available`.
stream trust.collections on entity asset.trust inflow currency USD {
  schedule every quarter from 2026-01 to 2027-10
  amount = 100000
}

// Your task: write the waterfall the documents describe, in document order —
//   1. servicing fee: 4,500 per quarter
//   2. debt service: 62,000 per quarter
//   3. residual: everything remaining, to the investor
// waterfall trust.distribution on entity asset.trust, scheduled quarterly,
// paying from available.
