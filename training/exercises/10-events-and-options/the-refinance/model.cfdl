version 0.1
model "exercise-the-refinance"
time calendar monthly from 2026-01 for 24

entity asset senior : Asset.Financial

// Both loans currently run for the full two years — which is wrong: the
// deal refinances at month 12. Your task:
//   1. Guard each loan with an `active when` on the lifecycle field
//      entity.state.status ("refinanced" / not).
//   2. Add an event that fires at time.t >= 12 and sets
//      entity asset.senior.status = "refinanced".
stream loan.bridge_interest on entity asset.senior outflow currency USD {
  schedule every month from 2026-01 to 2027-12
  amount = 9500
}

stream loan.perm_interest on entity asset.senior outflow currency USD {
  schedule every month from 2026-01 to 2027-12
  amount = 6200
}

stream ops.noi on entity asset.senior inflow currency USD {
  schedule every month from 2026-01 to 2027-12
  amount = 21000
}
