version 0.1
model "exercise-billing-terms"
time calendar monthly from 2026-01 for 12

entity asset agency : Asset.Intangible

// The agency bills 40,000 a month for six months of work. Two timing terms
// are missing from this model:
//   1. Clients pay net 45 — apply it to collections.
//   2. A 15,000 retainer deposit arrives at the START of January 2026 —
//      add it as a single-occurrence stream placed with `due` (hint: a
//      stride from 2026-01 to 2026-01 has exactly one occurrence).
stream agency.collections on entity asset.agency inflow currency USD {
  schedule every month from 2026-01 to 2026-06
  amount = 40000
}

stream agency.payroll on entity asset.agency outflow currency USD {
  schedule every month from 2026-01 to 2026-06
  amount = 26000
}
