version 0.1
model "exercise-billing-terms"
time calendar monthly from 2026-01 for 12

entity asset agency : Asset.Intangible

// net 45: January's invoice is March cash. The activity window is unchanged;
// only the cash placement moves.
stream agency.collections on entity asset.agency inflow currency USD {
  schedule every month net 45 from 2026-01 to 2026-06
  amount = 40000
}

stream agency.payroll on entity asset.agency outflow currency USD {
  schedule every month from 2026-01 to 2026-06
  amount = 26000
}

// The deposit is cash in advance. `start` places cash at its period's open, so a
// single-occurrence stride carries it: one January payment, placed at the
// period's start. (A bare `on` date sits at its period's end.)
stream agency.deposit on entity asset.agency inflow currency USD {
  schedule every month start from 2026-01 to 2026-01
  amount = 15000
}
