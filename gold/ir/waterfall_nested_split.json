      "source": {
        "lang": "cfdl",
        "src": "series_sum(\"fund.distribution.gp_catchup\", 0.0, 5.0)         + series_sum(\"fund.distribution.gp_promote\", 0.0, 5.0)"
      },
      "steps": [
        {
          "name": "team_pool",
          "payee": "party.team",
          "amount": {
