        },
        {
          "name": "class_c_target",
          "payee": "asset.class_c",
          "amount": {
            "lang": "cfdl",
            "src": "entity.asset.class_a.original_balance                                              + entity.asset.class_b.original_balance                                              + entity.asset.class_c.original_balance                                              - paid.class_a_target - paid.class_a_final                                              - paid.class_b_target - paid.class_b_final                                              - state.pool_balance"
          }
        },
        {
          "name": "class_c_final",
