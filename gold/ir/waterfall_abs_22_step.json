          }
        },
        {
          "name": "class_a_final",
          "payee": "asset.class_a",
          "amount": {
            "lang": "cfdl",
            "src": "if(time.t >= 5.0,                                                 entity.asset.class_a.original_balance, 0.0)"
          }
        },
        {
          "name": "class_b_interest",
          "payee": "asset.class_b",
          "amount": {
            "lang": "cfdl",
            "src": "300.0"
