        },
        {
          "name": "class_b_target",
          "payee": "asset.class_b",
          "amount": {
            "lang": "cfdl",
            "src": "entity.asset.class_a.original_balance                                              + entity.asset.class_b.original_balance                                              - paid.class_a_target - paid.class_a_final                                              - state.pool_balance"
          }
        },
        {
          "name": "class_b_final",
          "payee": "asset.class_b",
          "amount": {
            "lang": "cfdl",
