          }
        },
        {
          "name": "gp_catchup",
          "payee": "party.gp",
          "amount": {
            "lang": "cfdl",
            "src": "cfg.catchup_base                                   / (1.0 - inputs.gp_carry) * inputs.gp_carry"
          }
        },
        {
          "name": "gp_promote",
          "payee": "party.gp",
          "amount": {
            "lang": "cfdl",
            "src": "remaining * inputs.gp_carry"
