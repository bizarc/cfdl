{
  "name": "learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "sync:exercises": "node scripts/sync-exercises.mjs",
    "check:exercises": "node scripts/sync-exercises.mjs --check",
    "prebuild": "node scripts/sync-exercises.mjs --check && node scripts/check-wasm-bundle.mjs && node scripts/build-course-kit.mjs",
    "check:wasm": "node scripts/check-wasm-bundle.mjs",
    "build:wasm": "OUT_DIR=\"$PWD/public/wasm\" ../site/scripts/build-wasm.sh",
    "check:tokens": "./scripts/check-tokens.sh",
