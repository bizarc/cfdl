quantile intraday linear {
  0.000: 0.0681
  0.005: 0.2200
  0.010: 0.2588
  0.020: 0.3332
  0.050: 0.5984
  0.100: 0.7351
  0.200: 0.8417
  0.300: 0.8990
  0.400: 0.9375
  0.500: 0.9713
  0.600: 1.0049
  0.700: 1.0462
  0.800: 1.1019
  0.900: 1.2720
  0.950: 1.4772
  0.980: 1.6970
  0.990: 1.9133
  0.995: 4.0506
  0.999: 4.8404
  1.000: 5.1691
}

lifecycle facility {
  initial in_service
  state in_service, reserve_shutdown

  // Run at all only if the FIRST unit pays: the dearest hour it can reach
  // against the cheapest it must buy.
  in_service -> reserve_shutdown when
    curve_value("day_price", time.date) * quantile_at("intraday", 1.0)
    <= curve_value("day_price", time.date) * quantile_mean("intraday", 0.0, inputs.chg_share) / inputs.round_trip
       + inputs.cycle_cost_mwh

  reserve_shutdown -> in_service when
    curve_value("day_price", time.date) * quantile_at("intraday", 1.0)
    > curve_value("day_price", time.date) * quantile_mean("intraday", 0.0, inputs.chg_share) / inputs.round_trip
       + inputs.cycle_cost_mwh
}

// The energy actually moved: the share of the day's hours that clear the
// marginal cost, capped by what the asset can physically reach.
// `quantile_of` returns the share BELOW a price, so the share above is 1 - it.
stream market.discharge on entity asset.battery inflow currency USD {
  schedule every day from 2026-01-01 to 2026-12-31
  amount = min(1.0 - quantile_of("intraday",
                 (curve_value("day_price", time.date) * quantile_mean("intraday", 0.0, inputs.chg_share)
                    / inputs.round_trip + inputs.cycle_cost_mwh)
                 / curve_value("day_price", time.date)),
               inputs.dis_share)
         * 24.0 * inputs.power_mw
         * curve_value("day_price", time.date)
         * quantile_mean("intraday",
             1.0 - min(1.0 - quantile_of("intraday",
                 (curve_value("day_price", time.date) * quantile_mean("intraday", 0.0, inputs.chg_share)
                    / inputs.round_trip + inputs.cycle_cost_mwh)
                 / curve_value("day_price", time.date)),
               inputs.dis_share), 1.0)
  active in state in_service
}

// Charging is the same energy, grossed up for the loss, bought from the
// cheapest hours.
stream market.charge on entity asset.battery outflow currency USD {
  schedule every day from 2026-01-01 to 2026-12-31
  amount = min(1.0 - quantile_of("intraday",
                 (curve_value("day_price", time.date) * quantile_mean("intraday", 0.0, inputs.chg_share)
                    / inputs.round_trip + inputs.cycle_cost_mwh)
                 / curve_value("day_price", time.date)),
               inputs.dis_share)
         * 24.0 * inputs.power_mw / inputs.round_trip
         * curve_value("day_price", time.date)
         * quantile_mean("intraday", 0.0, inputs.chg_share)
  active in state in_service
}

metric days_run = series_count("market.discharge", 0, 364)
